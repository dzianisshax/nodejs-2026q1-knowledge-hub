# Application
PORT=4000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public"

# JWT
JWT_SECRET=your_access_token_secret_change_me
JWT_REFRESH_SECRET=your_refresh_token_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d