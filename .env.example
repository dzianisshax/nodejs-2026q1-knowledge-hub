# Application
PORT=4000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma connection string
# Uncomment the relevant one of the two proposed options
# option 1 -> Local dev (app runs on host, DB runs in Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public"

# option 2 -> Inside Docker (both app and DB run in Docker Compose):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public"

# JWT
JWT_SECRET=your_access_token_secret_change_me
JWT_REFRESH_SECRET=your_refresh_token_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Logging
LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300